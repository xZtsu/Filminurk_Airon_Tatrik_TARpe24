﻿
@model Filminurk.Models.OMDb.OmdbViewModel
<h2>Filmi import</h2>

<form method="post" asp-action="Index" asp-controller="OMDbapi">
    <input asp-for="Title" placeholder="Sisesta filmi nimi"/>
    <hr/>
    <button type="submit">Impordi</button>
</form>





@if (Model != null)
{
    <hr />
    <h3>@Model.Title </h3>
    <h3>@Model.Released </h3>
    <h3>@Model.Director </h3>
    <h3>@Model.Actors </h3>
    <p>@Model.Plot</p>
    <h3>@Model.imdbRating</h3>
}